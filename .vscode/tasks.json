{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lab: run current problem",
      "type": "shell",
      "command": "node lab.js run \"${relativeFileDirname}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Lab: test current problem",
      "type": "shell",
      "command": "node lab.js test \"${relativeFileDirname}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "JS: test all",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
